<html>
<script>
function doCalculate() {

    var a = myfrm.txt1.value;
    var b = myfrm.txt2.value;
    var choice = myfrm.txt3.value;

    if (choice == "+") {
        var c = parseInt(a) + parseInt(b);
        myfrm.ans.value = "Sum is " + c;
    }

    else if (choice == "-") {
        var c = parseInt(a) - parseInt(b);
        myfrm.ans.value = "Sub is " + c;
    }

    else if (choice == "*") {
        var c = parseInt(a) * parseInt(b);
        myfrm.ans.value = "Multiplication is " + c;
    }

    else if (choice == "/") {
        var c = parseInt(a) / parseInt(b);
        myfrm.ans.value = "Division is " + c;
    }
}
</script>

<body>
<form id="myfrm">

    No1 :
    <input type="text" name="txt1"><br><br>

    No2 :
    <input type="text" name="txt2"><br><br>

    Choice :
    <select name="txt3">
        <option>+</option>
        <option>-</option>
        <option>*</option>
        <option>/</option>
    </select>
    <br><br>

    <input type="button" value="Get Answer"
           onclick="doCalculate()"><br><br>

    <input type="text" name="ans" readonly>

</form>
</body>
</html>