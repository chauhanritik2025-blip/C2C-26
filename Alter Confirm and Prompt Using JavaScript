<html>
<head>
<script>

function demo1() {
    alert("Welcome to JavaScript");
}

function demo2() {
    var a = confirm("Are you sure?");

    if (a == true) {
        alert("Record Deleted");
    }
}

function demo3() {
    var a = prompt("Enter Number 1");
    var b = prompt("Enter Number 2");

    var c = parseInt(a) + parseInt(b);

    alert("Sum is " + c);
}

</script>
</head>

<body>

<input type="button" value="Button 1" onclick="demo1()">
<input type="button" value="Button 2" onclick="demo2()">
<input type="button" value="Button 3" onclick="demo3()">

</body>
</html>